# Copy this file to .env and fill in your values. Never commit .env.

# --- Supabase (Project Settings -> API in the Supabase dashboard) ---
# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# The "service_role" secret key. It bypasses Row Level Security, so keep it on the server only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Alternative for local development ---
# Leave the two Supabase values empty and set a Postgres connection string instead.
# Product images are then saved in ./uploads.
# DATABASE_URL=postgres://user:password@localhost:5432/caq

# --- Seller logins ---
BOUTIQUE_PASSWORD=change-me
CAFE_PASSWORD=change-me-too

# PORT=3000
